答案.json

# 2) 过程产物：解析、校验、中间数据不入库
_dump/
_work/
__pycache__/
*.pyc
.venv/
venv/
node_modules/

# 3) Office/Word 临时锁文件
~$*

# 4) 系统文件
Thumbs.db
desktop.ini
.DS_Store
